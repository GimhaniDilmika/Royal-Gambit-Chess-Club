rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure role-based authorization using Firebase Auth Custom Claims
    function isSignedIn() {
      return request.auth != null;
    }

    // Role verification via Custom Claims (Primary authority)
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isCoach() {
      return isSignedIn() && (request.auth.token.role == 'coach' || isAdmin());
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      // Authenticated users can read club profiles (for member directory, coach lists)
      allow read: if isSignedIn();

      // New users can ONLY create their own profile with role strictly forced to 'member'
      // Passwords are NEVER allowed in Firestore documents
      allow create: if isOwner(userId) 
                    && request.resource.data.role == 'member'
                    && request.resource.data.uid == userId
                    && !('password' in request.resource.data);

      // Users can update their own permitted profile fields, but NEVER escalate or change their role
      // Only an Admin can modify user roles or administrative status
      allow update: if (isOwner(userId) 
                        && request.resource.data.role == resource.data.role
                        && !('password' in request.resource.data))
                    || isAdmin();

      // Only Admins can delete user profiles
      allow delete: if isAdmin();
    }

    // --- TOURNAMENTS COLLECTION ---
    match /tournaments/{tournamentId} {
      // Club members can view tournaments
      allow read: if isSignedIn();
      // Only Coaches and Admins can create and edit tournaments
      allow create, update: if isCoach();
      allow delete: if isAdmin();
    }

    // --- TRAINING SESSIONS COLLECTION ---
    match /training_sessions/{sessionId} {
      // Students can view sessions they are enrolled in, coaches/admins can view all
      allow read: if isSignedIn() && (
        isCoach() || 
        resource.data.studentId == request.auth.uid
      );
      // Only coaches and admins can create/update sessions
      allow create, update: if isCoach();
      allow delete: if isAdmin();
    }

    // --- CLUB ANNOUNCEMENTS ---
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- AUDIT LOGS & ADMIN STATS ---
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
